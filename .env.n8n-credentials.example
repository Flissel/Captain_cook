# Local n8n credential setup template. Copy to .env.n8n-credentials.
# This file is documentation only: n8n credentials must be created in the n8n UI
# and remain encrypted in n8n's credential store. Do not commit the copied file.

# HTTP Request -> Bearer Auth credential
CAPTAIN_N8N_BEARER_CREDENTIAL_NAME=Captain Demo Bearer
CAPTAIN_N8N_BEARER_TOKEN=replace-with-a-dedicated-provider-token

# HTTP Request -> OAuth2 API credential
CAPTAIN_N8N_OAUTH2_CREDENTIAL_NAME=Captain Demo OAuth2
CAPTAIN_N8N_OAUTH2_CLIENT_ID=
CAPTAIN_N8N_OAUTH2_CLIENT_SECRET=
CAPTAIN_N8N_OAUTH2_AUTH_URL=
CAPTAIN_N8N_OAUTH2_ACCESS_TOKEN_URL=
