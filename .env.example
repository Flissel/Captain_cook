# Only required for the legacy API-key-backed prototype, never for `python main.py demo`.
OPENAI_API_KEY=
CAPTAIN_MODEL=gpt-5.6
CAPTAIN_TIMEZONE=Europe/Berlin

# Planning-only AgentFarm evaluation. Keep the source path local and uncommitted.
AGENTFARM_INPUT_PATH=
AGENTFARM_EVALUATION_MAX_COMPONENTS=1
AGENTFARM_EVALUATION_MAX_ROUNDS=3
AGENTFARM_EVALUATION_MAX_CALLS=8

# Captain and Minibook.
MINIBOOK_PUBLIC_URL=http://localhost:3457
MINIBOOK_BACKEND_URL=http://localhost:3456
MINIBOOK_API_KEY=
MINIBOOK_PROJECTION_API_KEY=
MINIBOOK_CREATION_DB=.captain-cook/minibook/creation.sqlite3
MINIBOOK_PROJECTION_PROJECT_ID=captain-runtime-projection-v2
MINIBOOK_PROJECTION_SERVICE_AGENT_ID=captain-projection-service-v2
# Created only by scripts/minibook-demo.ps1 in the local Minibook instance.
CAPTAIN_DEMO_MINIBOOK_API_KEY=

# Local delivery services.
MAILPIT_WEB_PORT=18025
MAILPIT_SMTP_PORT=1025
MAILPIT_URL=http://localhost:18025
MAILPIT_SMTP_HOST=host.docker.internal
MARIADB_PORT=3306
MARIADB_DATABASE=captain_ledger
MARIADB_USER=captain
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Isolated, disposable live-demo/test Gateway database. The bootstrap generates
# local-only passwords and the DSN; never point TEST_MARIADB_DSN elsewhere.
MARIADB_TEST_PORT=33306
MARIADB_TEST_PASSWORD=
MARIADB_TEST_ROOT_PASSWORD=
TEST_MARIADB_DSN=

# Dedicated provider-live benchmark database. It uses a named persistent volume
# so Captain lifecycle evidence survives restarts; do not delete that volume.
MARIADB_BENCHMARK_PORT=33316

# Captain Gateway. Keep tokens local; the default claim lease is 90 minutes.
LEDGER_DSN=
CAPTAIN_GATEWAY_TOKEN=
WORKER_GATEWAY_TOKEN=
CAPTAIN_GATEWAY_URL=http://127.0.0.1:8090
GATEWAY_APPROVAL_ENABLED=false
GATEWAY_PORT=8090
CAPTAIN_BENCHMARK_GATEWAY_PORT=8092
GATEWAY_CLAIM_TTL_SECONDS=5400

# Sealed three-input capability assembly. All values are required together;
# an incomplete group leaves the Captain-only API at fail-closed HTTP 503.
CAPTAIN_CAPABILITY_ASSEMBLY_REPOSITORY_REVISION=
CAPTAIN_CAPABILITY_ASSEMBLY_INPUTS_JSON={}
CAPTAIN_CAPABILITY_ASSEMBLY_TOOL_GAPS_JSON={}
CAPTAIN_CAPABILITY_ASSEMBLY_SUBJECT_VERSION=1
CAPTAIN_CAPABILITY_BENCHMARK_URL=http://127.0.0.1:8092/v1/execute
CAPTAIN_CAPABILITY_BENCHMARK_TOKEN=
CAPTAIN_CAPABILITY_BENCHMARK_GATEWAY_TOKEN=
CAPTAIN_CAPABILITY_BENCHMARK_AUTHORITY_ID=
CAPTAIN_CAPABILITY_BENCHMARK_PORT=8092
CAPTAIN_CAPABILITY_BENCHMARK_EXECUTOR=gateway/capability_benchmark_executor_adapter.py
CAPTAIN_CAPABILITY_BENCHMARK_EXECUTOR_SHA256=ae1396f98602a3578179c97e04760dceab1c55bf44b7c8c2a07d9696d9979e94
CAPTAIN_CAPABILITY_BENCHMARK_HOST_WORKER_SHA256=5dc93ab5db626a68fcbf768b0aac43ef251b3d0879e42381fa5fd89447b31744
CAPTAIN_GENERIC_TOOL_REGISTRY=config/generic_tool_registry.json
CAPTAIN_GENERIC_TOOL_REGISTRY_SHA256=1cc99b7ef95ddedebc64f2b1c4ad3b88c5fcbfa748f536e93606af76c1994f5f
CAPTAIN_CAPABILITY_TOOL_HOST_TOKEN=
CAPTAIN_CAPABILITY_TOOL_HOST_PORT=8110
CAPTAIN_CAPABILITY_TOOL_HOST_URL=http://127.0.0.1:8110
CAPTAIN_CAPABILITY_TOOL_HOST_CODE_SHA256=df2fdbdba8deab091bc2040959c56b3a267d4fa428484146db0311ef78d221f0
CAPTAIN_CAPABILITY_TOOL_HOST_JOURNAL_ROOT=.captain/capability-tool-host-journal
CAPTAIN_CAPABILITY_TOOL_HOST_SALES_DATASET=config/demo_tool_data/sales.json
CAPTAIN_CAPABILITY_TOOL_HOST_SALES_DATASET_SHA256=323fda6345f5a3e9c96f60dafb1ba69f55b01dccfa748d563802b6b425b81c99
CAPTAIN_CAPABILITY_TOOL_HOST_INCIDENT_DATASET=config/demo_tool_data/incident.json
CAPTAIN_CAPABILITY_TOOL_HOST_INCIDENT_DATASET_SHA256=37c6627c77cc7d473bc456de3450952046076e0d67b95dd5fe0b4155ba9b0646
CAPTAIN_CAPABILITY_TOOL_HOST_CLAIMS_DATASET=config/demo_tool_data/claims.json
CAPTAIN_CAPABILITY_TOOL_HOST_CLAIMS_DATASET_SHA256=82b4d6d2aafa0e719711a9a6146a715f5c4a286922c79a17aba68adb4b26765b
CAPTAIN_CAPABILITY_ARTIFACT_ROOT=.captain-cook/artifacts/sha256
CAPTAIN_CAPABILITY_AUTHORITY_ROOT=.captain-cook/capability-authority
CAPTAIN_CAPABILITY_FACTORY_ADAPTER=gateway/capability_factory_runtime_adapter.py
CAPTAIN_CAPABILITY_FACTORY_ADAPTER_SHA256=b611d3ccd0ef7663c97ded0798283da3c1a3fff5fb63fd32a043533ab6d5a35a
CAPTAIN_CAPABILITY_FACTORY_DESCRIPTOR=gateway/capability_factory_runtime_descriptor.json
CAPTAIN_CAPABILITY_FACTORY_PLAN_SHA256=fc61cae4c5dfa22e37d851374d9316e1795adb4ae44cbe09218bdb79128428c2
CAPTAIN_CAPABILITY_EXECUTION_POLICY_JSON={}
CAPTAIN_PROCESS_STATE_ROOT=.captain-cook/processes
# Comma-separated non-loopback HTTPS hosts. Loopback needs no entry.
CAPTAIN_CAPABILITY_ALLOWED_HOSTS=

# Authenticated Captain runtime boundary. The local bootstrap generates the token.
CAPTAIN_RUNTIME_TOKEN=
CAPTAIN_RUNTIME_URL=http://127.0.0.1:8091
CAPTAIN_RUNTIME_PORT=8091
CAPTAIN_RUNTIME_ADAPTER_MANIFEST=
CAPTAIN_RUNTIME_ADAPTER_MANIFEST_SHA256=
CAPTAIN_CODEX_MODEL=gpt-5.6-terra
CAPTAIN_CODEX_REASONING_EFFORT=high
CAPTAIN_PROVIDER_PROXY_URL=http://127.0.0.1:18091
CAPTAIN_PROVIDER_PROXY_RESPONSES_URL=http://127.0.0.1:18091/v1
CAPTAIN_PROVIDER_POLICY_SHA256=
CAPTAIN_PROVIDER_PRICE_CARD_SHA256=92d1035bceba810df85a3c97d886ff5bcbdc11a08093126fa3b8f84dde9418e4
CAPTAIN_PROVIDER_CONTEXT_SHA256=
CAPTAIN_PROVIDER_PROXY_EXECUTABLE_SHA256=
CAPTAIN_PROVIDER_PROXY_CODE_SHA256=
CAPTAIN_PROVIDER_PAID_COMMAND_SHA256=
CAPTAIN_PROVIDER_HARD_CEILING_ENFORCED=true
CAPTAIN_PROVIDER_PROXY_CLIENT_TOKEN=
CAPTAIN_PROVIDER_PRICE_CARD_PATH=config/openai-price-card-terra-2026-08-09.json
CAPTAIN_PROVIDER_POLICY_PATH=
CAPTAIN_PROVIDER_STATE_ROOT=.captain-cook/provider-proxy
CAPTAIN_PROVIDER_RECEIPT_GATEWAY_TOKEN=

# Provider-backed business benchmark gate. Values are identities and limits,
# never credentials. The selected provider secret stays in its existing blank
# secret variable above and is checked for existence without printing it.
CAPTAIN_BENCHMARK_PROFILE=claims
CAPTAIN_BENCHMARK_PROVIDER=openai
CAPTAIN_BENCHMARK_MODEL=gpt-5.6
# SHA-256 of the Captain-released redaction policy used by every selected team.
CAPTAIN_BENCHMARK_REDACTION_POLICY_SHA256=
CAPTAIN_BENCHMARK_SUITE_VERSION=1
CAPTAIN_BENCHMARK_CANDIDATE_ID=candidate-version-id
CAPTAIN_BENCHMARK_JOB_ID=00000000-0000-0000-0000-000000000000
CAPTAIN_BENCHMARK_ATTEMPT=1
CAPTAIN_BENCHMARK_MAX_USD=1.00
CAPTAIN_JOB_REMAINING_USD=1.00
# Profile=all never reuses the generic team identity above. Each team requires
# its own Captain job, candidate, suite/attempt, and isolated budget.
CAPTAIN_BENCHMARK_CLAIMS_SUITE_VERSION=
CAPTAIN_BENCHMARK_CLAIMS_CANDIDATE_ID=
CAPTAIN_BENCHMARK_CLAIMS_JOB_ID=
CAPTAIN_BENCHMARK_CLAIMS_ATTEMPT=
CAPTAIN_BENCHMARK_CLAIMS_MAX_USD=
CAPTAIN_BENCHMARK_CLAIMS_REMAINING_USD=
CAPTAIN_BENCHMARK_RENEWAL_SUITE_VERSION=
CAPTAIN_BENCHMARK_RENEWAL_CANDIDATE_ID=
CAPTAIN_BENCHMARK_RENEWAL_JOB_ID=
CAPTAIN_BENCHMARK_RENEWAL_ATTEMPT=
CAPTAIN_BENCHMARK_RENEWAL_MAX_USD=
CAPTAIN_BENCHMARK_RENEWAL_REMAINING_USD=
CAPTAIN_JOB_ALLOWED_MODELS=gpt-5.6
CAPTAIN_BENCHMARK_EVIDENCE_ROOT=.captain-cook/evidence/business-benchmarks/local-run
CAPTAIN_BENCHMARK_PROVIDER_SECRET=OPENAI_API_KEY
# Non-secret local executable identities for Captain-owned Factory builds.
CAPTAIN_CODEX_EXECUTABLE=
CAPTAIN_PWSH_EXECUTABLE=
CAPTAIN_CODEX_HOME=

# Captain-private capability benchmark catalog. Production must use an absolute
# dedicated root outside every Git repository/worktree. Generate locally with
# scripts/init-private-benchmark-catalog.py. Never commit the generated JSON;
# seed material is OS-random or read ephemerally from stdin and is never stored.
CAPTAIN_PRIVATE_BENCHMARK_ROOT=C:/captain-private/private-benchmarks
CAPTAIN_PRIVATE_BENCHMARK_MANIFEST_PATH=catalog.json
CAPTAIN_PRIVATE_BENCHMARK_MANIFEST_SHA256=

# Captain Cook uses the existing VibeMind n8n instance by default.
N8N_MODE=external
N8N_URL=http://localhost:15678
N8N_CONTAINER_URL=http://host.docker.internal:15678
N8N_MCP_URL=http://localhost:15678/mcp-server/http
N8N_MCP_TOKEN=

# Set N8N_MODE=captain-builder to opt into the isolated Captain-owned builder.
CAPTAIN_N8N_URL=http://localhost:5679
CAPTAIN_N8N_API_KEY=
CAPTAIN_N8N_MCP_TOKEN=
CAPTAIN_N8N_PORT=5679
# The Gateway installs both self-service discovery and provider-verification
# adapters only when this complete group is present. Release JSON contains
# immutable Gitea metadata only; never workflow bytes or credential values.
CAPTAIN_PORTAL_N8N_ADAPTERS_ENABLED=false
CAPTAIN_PORTAL_GITEA_ORIGIN=
CAPTAIN_PORTAL_VERIFICATION_RELEASES_JSON=[]
# Compatibility aliases accepted by scripts/demo-preflight.ps1.
N8N_API_KEY=
CONTEXT7_API_KEY=

# Mini-PC self-service portal. These are public browser/runtime endpoints and
# the public Supabase anon key; never place service-role or provider secrets here.
CAPTAIN_PORTAL_URL=https://mini-pc.local:8444
CAPTAIN_PORTAL_SUPABASE_URL=https://supabase.example.test
CAPTAIN_PORTAL_SUPABASE_ANON_KEY=
CAPTAIN_PORTAL_GITEA_URL=https://gitea.example.test
CAPTAIN_PORTAL_TLS_CERT_PATH=C:/captain-portal-secrets/portal.crt
CAPTAIN_PORTAL_TLS_KEY_PATH=C:/captain-portal-secrets/portal.key
CAPTAIN_PORTAL_IMAGE_TAG=local
# Required only for rollback; use the exact registry/repository@sha256 digest
# accepted by Captain release evidence, never a mutable tag.
CAPTAIN_PORTAL_ACCEPTED_IMAGE=
CAPTAIN_PORTAL_MINI_PC_ENDPOINT=192.168.178.65

# Captain-side control capabilities. Configure all three with distinct random
# values in a gitignored environment. They are not browser or provider secrets.
PORTAL_PROVIDER_CONTROL_TOKEN=
PORTAL_EVIDENCE_TOKEN=
PORTAL_RESTART_CONTROL_TOKEN=
