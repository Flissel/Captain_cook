# Only required for the legacy API-key-backed prototype, never for `python main.py demo`.
OPENAI_API_KEY=
CAPTAIN_MODEL=gpt-5.6
CAPTAIN_TIMEZONE=Europe/Berlin

# Planning-only AgentFarm evaluation. Keep the source path local and uncommitted.
AGENTFARM_INPUT_PATH=
AGENTFARM_EVALUATION_MAX_COMPONENTS=1
AGENTFARM_EVALUATION_MAX_ROUNDS=3
AGENTFARM_EVALUATION_MAX_CALLS=8

# Captain and Minibook.
MINIBOOK_PUBLIC_URL=http://localhost:3457
MINIBOOK_BACKEND_URL=http://localhost:3456
MINIBOOK_API_KEY=
MINIBOOK_PROJECTION_API_KEY=
# Build Dockerfile.capability-sandbox, then pin its local captain-* RepoDigest.
# Example: captain-capability-sandbox@sha256:<64 lowercase hex characters>
CAPTAIN_CAPABILITY_SANDBOX_IMAGE=
# Created only by scripts/minibook-demo.ps1 in the local Minibook instance.
CAPTAIN_DEMO_MINIBOOK_API_KEY=

# Local delivery services.
MAILPIT_WEB_PORT=18025
MAILPIT_SMTP_PORT=1025
MAILPIT_URL=http://localhost:18025
MAILPIT_SMTP_HOST=host.docker.internal
MARIADB_PORT=3306
MARIADB_DATABASE=captain_ledger
MARIADB_USER=captain
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Isolated, disposable live-demo Gateway database. The bootstrap generates
# local-only passwords and the DSN; never point TEST_MARIADB_DSN elsewhere.
MARIADB_TEST_PORT=33306
MARIADB_TEST_PASSWORD=
MARIADB_TEST_ROOT_PASSWORD=
TEST_MARIADB_DSN=

# Captain Gateway. Keep tokens local; the default claim lease is 90 minutes.
LEDGER_DSN=
CAPTAIN_GATEWAY_TOKEN=
WORKER_GATEWAY_TOKEN=
CAPTAIN_GATEWAY_URL=http://127.0.0.1:8090
GATEWAY_APPROVAL_ENABLED=false
GATEWAY_PORT=8090
GATEWAY_CLAIM_TTL_SECONDS=5400

# Authenticated Captain runtime boundary. The local bootstrap generates the token.
CAPTAIN_RUNTIME_TOKEN=
CAPTAIN_RUNTIME_URL=http://127.0.0.1:8091
CAPTAIN_RUNTIME_PORT=8091

# Digest-pinned production Capability/Factory runtime adapter. The job ID is
# issued by Captain/Gateway; adapter paths must remain inside this workspace.
CAPTAIN_FACTORY_JOB_ID=
CAPTAIN_FACTORY_PROVIDER=openai
CAPTAIN_FACTORY_HERMES_PROVIDER=openai-api
CAPTAIN_FACTORY_MODEL=
CAPTAIN_FACTORY_MAX_COST_USD=
CAPTAIN_FACTORY_MAX_COST_PER_CALL_USD=
CAPTAIN_FACTORY_PRICING_VERSION=
CAPTAIN_FACTORY_PRICING_EFFECTIVE_AT=
CAPTAIN_FACTORY_PRICING_INPUT_COST_PER_MILLION_USD=
CAPTAIN_FACTORY_PRICING_OUTPUT_COST_PER_MILLION_USD=
CAPTAIN_FACTORY_PRICING_MINIMUM_COST_USD=
CAPTAIN_FACTORY_N8N_WORKFLOW_ID=
CAPABILITY_FACTORY_ENTRYPOINT_ADAPTER_MANIFEST=
CAPABILITY_FACTORY_ENTRYPOINT_ADAPTER_SHA256=
FACTORY_LIVE_RUNTIME_ADAPTER_MANIFEST=
FACTORY_LIVE_RUNTIME_ADAPTER_SHA256=

# Captain Cook uses the existing VibeMind n8n instance by default.
N8N_MODE=external
N8N_URL=http://localhost:15678
N8N_CONTAINER_URL=http://host.docker.internal:15678
N8N_MCP_URL=http://localhost:15678/mcp-server/http
N8N_MCP_TOKEN=

# Set N8N_MODE=captain-builder to opt into the isolated Captain-owned builder.
CAPTAIN_N8N_URL=http://localhost:5679
CAPTAIN_N8N_API_KEY=
CAPTAIN_N8N_MCP_TOKEN=
CAPTAIN_N8N_MCP_BROKER_URL=http://localhost:5680
CAPTAIN_N8N_MCP_BROKER_SIGNING_SECRET=
CAPTAIN_N8N_PROJECT_ID=factory-live-demo
CAPTAIN_N8N_BATCH_ID=factory-live-demo-n8n
CAPTAIN_N8N_WORKSPACE_REF=workspace://factory-live-demo/n8n
CAPTAIN_N8N_PORT=5679
# Compatibility aliases accepted by scripts/demo-preflight.ps1.
N8N_API_KEY=
CONTEXT7_API_KEY=
