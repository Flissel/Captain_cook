# Only required for the legacy API-key-backed prototype, never for `python main.py demo`.
OPENAI_API_KEY=
CAPTAIN_MODEL=gpt-5.6
CAPTAIN_TIMEZONE=Europe/Berlin

# Planning-only AgentFarm evaluation. Keep the source path local and uncommitted.
AGENTFARM_INPUT_PATH=
AGENTFARM_EVALUATION_MAX_COMPONENTS=1
AGENTFARM_EVALUATION_MAX_ROUNDS=3
AGENTFARM_EVALUATION_MAX_CALLS=8

# Captain and Minibook.
MINIBOOK_PUBLIC_URL=http://localhost:3457
MINIBOOK_BACKEND_URL=http://localhost:3456
MINIBOOK_API_KEY=
MINIBOOK_PROJECTION_API_KEY=
# Created only by scripts/minibook-demo.ps1 in the local Minibook instance.
CAPTAIN_DEMO_MINIBOOK_API_KEY=

# Local delivery services.
MAILPIT_WEB_PORT=18025
MAILPIT_SMTP_PORT=1025
MAILPIT_URL=http://localhost:18025
MAILPIT_SMTP_HOST=host.docker.internal
MARIADB_PORT=3306
MARIADB_DATABASE=captain_ledger
MARIADB_USER=captain
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Isolated, disposable live-demo/test Gateway database. The bootstrap generates
# local-only passwords and the DSN; never point TEST_MARIADB_DSN elsewhere.
MARIADB_TEST_PORT=33306
MARIADB_TEST_PASSWORD=
MARIADB_TEST_ROOT_PASSWORD=
TEST_MARIADB_DSN=

# Dedicated provider-live benchmark database. It uses a named persistent volume
# so Captain lifecycle evidence survives restarts; do not delete that volume.
MARIADB_BENCHMARK_PORT=33316

# Captain Gateway. Keep tokens local; the default claim lease is 90 minutes.
LEDGER_DSN=
CAPTAIN_GATEWAY_TOKEN=
WORKER_GATEWAY_TOKEN=
CAPTAIN_GATEWAY_URL=http://127.0.0.1:8090
GATEWAY_APPROVAL_ENABLED=false
GATEWAY_PORT=8090
CAPTAIN_BENCHMARK_GATEWAY_PORT=8092
GATEWAY_CLAIM_TTL_SECONDS=5400

# Authenticated Captain runtime boundary. The local bootstrap generates the token.
CAPTAIN_RUNTIME_TOKEN=
CAPTAIN_RUNTIME_URL=http://127.0.0.1:8091
CAPTAIN_RUNTIME_PORT=8091

# Provider-backed business benchmark gate. Values are identities and limits,
# never credentials. The selected provider secret stays in its existing blank
# secret variable above and is checked for existence without printing it.
CAPTAIN_BENCHMARK_PROFILE=claims
CAPTAIN_BENCHMARK_PROVIDER=openai
CAPTAIN_BENCHMARK_MODEL=gpt-5.6
# SHA-256 of the Captain-released redaction policy used by every selected team.
CAPTAIN_BENCHMARK_REDACTION_POLICY_SHA256=
CAPTAIN_BENCHMARK_SUITE_VERSION=1
CAPTAIN_BENCHMARK_CANDIDATE_ID=candidate-version-id
CAPTAIN_BENCHMARK_JOB_ID=00000000-0000-0000-0000-000000000000
CAPTAIN_BENCHMARK_ATTEMPT=1
CAPTAIN_BENCHMARK_MAX_USD=1.00
CAPTAIN_JOB_REMAINING_USD=1.00
# Profile=all never reuses the generic team identity above. Each team requires
# its own Captain job, candidate, suite/attempt, and isolated budget.
CAPTAIN_BENCHMARK_CLAIMS_SUITE_VERSION=
CAPTAIN_BENCHMARK_CLAIMS_CANDIDATE_ID=
CAPTAIN_BENCHMARK_CLAIMS_JOB_ID=
CAPTAIN_BENCHMARK_CLAIMS_ATTEMPT=
CAPTAIN_BENCHMARK_CLAIMS_MAX_USD=
CAPTAIN_BENCHMARK_CLAIMS_REMAINING_USD=
CAPTAIN_BENCHMARK_RENEWAL_SUITE_VERSION=
CAPTAIN_BENCHMARK_RENEWAL_CANDIDATE_ID=
CAPTAIN_BENCHMARK_RENEWAL_JOB_ID=
CAPTAIN_BENCHMARK_RENEWAL_ATTEMPT=
CAPTAIN_BENCHMARK_RENEWAL_MAX_USD=
CAPTAIN_BENCHMARK_RENEWAL_REMAINING_USD=
CAPTAIN_JOB_ALLOWED_MODELS=gpt-5.6
CAPTAIN_BENCHMARK_EVIDENCE_ROOT=.captain-cook/evidence/business-benchmarks/local-run
CAPTAIN_BENCHMARK_PROVIDER_SECRET=OPENAI_API_KEY
# Non-secret local executable identities for Captain-owned Factory builds.
CAPTAIN_CODEX_EXECUTABLE=
CAPTAIN_PWSH_EXECUTABLE=
CAPTAIN_CODEX_HOME=

# Captain Cook uses the existing VibeMind n8n instance by default.
N8N_MODE=external
N8N_URL=http://localhost:15678
N8N_CONTAINER_URL=http://host.docker.internal:15678
N8N_MCP_URL=http://localhost:15678/mcp-server/http
N8N_MCP_TOKEN=

# Set N8N_MODE=captain-builder to opt into the isolated Captain-owned builder.
CAPTAIN_N8N_URL=http://localhost:5679
CAPTAIN_N8N_API_KEY=
CAPTAIN_N8N_MCP_TOKEN=
CAPTAIN_N8N_PORT=5679
# Compatibility aliases accepted by scripts/demo-preflight.ps1.
N8N_API_KEY=
CONTEXT7_API_KEY=

# Mini-PC self-service portal. These are public browser/runtime endpoints and
# the public Supabase anon key; never place service-role or provider secrets here.
CAPTAIN_PORTAL_URL=http://mini-pc.local:8088
CAPTAIN_PORTAL_SUPABASE_URL=https://supabase.example.test
CAPTAIN_PORTAL_SUPABASE_ANON_KEY=
CAPTAIN_PORTAL_GITEA_URL=https://gitea.example.test
CAPTAIN_PORTAL_IMAGE_TAG=local
# Required only for rollback; use the exact registry/repository@sha256 digest
# accepted by Captain release evidence, never a mutable tag.
CAPTAIN_PORTAL_ACCEPTED_IMAGE=
